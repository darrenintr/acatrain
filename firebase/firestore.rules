rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Progress: one payload string, at most 128 KiB. Deletion: one immutable
    // true boolean. The marker contains no email, profile or study data.
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function active(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid)/state/deletion);
    }
    function validProgress() {
      return request.resource.data.keys().hasAll(['payload'])
        && request.resource.data.keys().hasOnly(['payload'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 131072;
    }
    match /users/{uid}/state/progress {
      allow get: if owner(uid) && active(uid);
      // DELETE remains allowed after marking so a failed Auth deletion can
      // be retried. No client can remove or reverse the deletion marker.
      allow delete: if owner(uid);
      allow create, update: if owner(uid) && active(uid) && validProgress()
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/state/deletion);
    }
    match /users/{uid}/state/deletion {
      function validDeletion() {
        return request.resource.data.keys().hasAll(['deleted'])
          && request.resource.data.keys().hasOnly(['deleted'])
          && request.resource.data.deleted is bool
          && request.resource.data.deleted == true;
      }
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validDeletion()
        && !existsAfter(/databases/$(database)/documents/users/$(uid)/state/progress);
    }
    // Worker service-account IAM is the only publishing path.
    // Public clients cannot read drafts or write releases/config/audit.
    match /{document=**} { allow read, write: if false; }
  }
}
